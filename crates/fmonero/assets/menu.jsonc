// fmonero menu entries, merged into ~/.config/omarchy/extensions/omarchy-menu.jsonc by
// `fmonero setup --menu`. Every entry is ONE line: the merge inserts lines textually before
// the file's final `}` and never rewrites what is already there (DESIGN.md §4.2).
// The docs agent may change labels and glyphs; ids and actions are the contract.
// Every action is a CONSTANT LITERAL: `omarchy-launch-or-focus-tui` ends in an `eval`, so
// nothing derived from Status JSON or user input may ever reach one (§1.5).
{
  "monero": {"icon":"󰗠","label":"fmonero","aliases":["fmonero","monero","xmr","wallet"]},
  "monero.open": {"icon":"󰆍","label":"Open","action":"fmonero launch wallet"},
  "monero.send": {"icon":"󰧧","label":"Send","action":"fmonero launch send"},
  "monero.wallet": {"icon":"󰉉","label":"Wallet","action":"fmonero launch wallet"},
  "monero.receive": {"icon":"󰧨","label":"Receive / payment request","action":"fmonero launch receive"},
  "monero.new-address": {"icon":"󰐕","label":"New address","action":"fmonero launch new-address"},
  "monero.restore": {"icon":"󰁯","label":"Restore wallet","action":"fmonero launch restore"},
  "monero.logs": {"icon":"󰦨","label":"Live logs","action":"fmonero launch logs"},
  "monero.tools": {"icon":"󰒓","label":"Advanced tools","action":"fmonero launch tools"},
  "monero.node": {"icon":"󰒋","label":"Nodes","action":"fmonero launch node"},
  "monero.doctor": {"icon":"󰩺","label":"Doctor","action":"omarchy-launch-or-focus-tui --app-id=org.odcpw.fmonerodoctor fmonero doctor"}
}
